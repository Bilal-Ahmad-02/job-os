# Job OS: keep source, migrations, dependency lockfiles, and sanitized examples.
# Store private runtime data in the ignored directories below.
# Ignore rules do not remove files that Git already tracks.

# Python / FastAPI: bytecode, packaging, test and analysis caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/

# Virtual environments / Conda (keep environment.yml and dependency lockfiles)
.venv/
venv/
env/
ENV/
envs/
.conda/
conda-env/
conda-meta/

# Node.js / React / frontend tooling
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.yarn/build-state.yml
.pnp.*
.vite/
.vite-temp/
.next/
.nuxt/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
coverage/
playwright-report/
test-results/

# Rust / Tauri (keep Cargo.lock, Cargo.toml, and Tauri configuration)
target/
**/src-tauri/gen/schemas/
*.rs.bk

# Build output and general caches
build/
dist/
out/
.cache/
.turbo/
*.whl

# VS Code: ignore personal settings; permit shared, reviewed project files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace
.history/

# Windows / editor temporary files
Thumbs.db
